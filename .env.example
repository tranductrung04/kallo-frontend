# ── Kallo Mobile Environment Configuration ─────────────────────────────────────
# Sao chép file này thành .env hoặc .env.local và cấu hình theo nhu cầu.

# EXPO_PUBLIC_DATA_MODE:
#   - 'backend': Kết nối trực tiếp với Spring Boot backend (mặc định cho dev/prod)
#   - 'demo': Hoạt động ngoại tuyến với dữ liệu mẫu (không cần chạy backend)
EXPO_PUBLIC_DATA_MODE=backend

# EXPO_PUBLIC_API_URL:
#   - Localhost (máy ảo iOS / web): http://127.0.0.1:8080/api
#   - Máy ảo Android: http://10.0.2.2:8080/api (tự động chuyển đổi nếu dùng 127.0.0.1 hoặc localhost)
#   - Thiết bị thật qua WiFi LAN: http://<IP_MÁY_TÍNH>:8080/api (ví dụ http://192.168.1.50:8080/api)
#   - Production: https://api.kallo.health/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080/api

# EXPO_PUBLIC_USE_LOCAL_DEMO:
#   - 'false': Nghiêm ngặt kết nối backend, không tự động fallback ngầm
#   - 'true': Bật chế độ demo ngoại tuyến
EXPO_PUBLIC_USE_LOCAL_DEMO=false

# Google OAuth Client IDs (Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

