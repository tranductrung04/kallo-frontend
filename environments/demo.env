# ── Kallo Mobile - Demo Mode Configuration ─────────────────────────────────────
# Chế độ demo ngoại tuyến sử dụng dữ liệu mẫu, không cần backend
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_USE_LOCAL_DEMO=true
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Google OAuth Client IDs (Mock for demo)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=demo-web-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=demo-android-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=demo-ios-client-id

