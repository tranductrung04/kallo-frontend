# ── Kallo Mobile - Production Mode Configuration ───────────────────────────────
# Chế độ sản xuất dành cho CI/CD và bản build phát hành
EXPO_PUBLIC_DATA_MODE=backend
EXPO_PUBLIC_USE_LOCAL_DEMO=false
EXPO_PUBLIC_API_URL=https://api.kallo.health/api

# Google OAuth Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

