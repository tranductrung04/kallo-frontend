{
  "name": "kallo-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start -c",
    "start:dev": "node scripts/switch-env.js dev && expo start -c",
    "start:demo": "node scripts/switch-env.js demo && expo start -c",
    "env:dev": "node scripts/switch-env.js dev",
    "env:demo": "node scripts/switch-env.js demo",
    "env:prod": "node scripts/switch-env.js prod",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "self-check": "node scripts/self-check.js && node scripts/phase2-self-check.js && node scripts/phase3-self-check.js && node scripts/phase4-self-check.js && node scripts/phase5-self-check.js && node scripts/phase6-self-check.js && node scripts/phase7-self-check.js && node scripts/phase8-self-check.js",
    "copy-assets": "node scripts/copy-assets.js"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "axios": "^1.7.9",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.20",
    "expo-auth-session": "~57.0.17",
    "expo-camera": "~57.0.6",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.72.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^58.0.16",
    "typescript": "~6.0.3"
  }
}
